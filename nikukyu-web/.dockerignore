# Build only the files needed for the production web bundle and nginx.
*
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!rsbuild.config.ts
!index.html
!nginx.conf
!src/
!src/**

# Never send local environment files, private keys or installed packages.
**/node_modules
**/.env*
**/*.pem
**/*.key
